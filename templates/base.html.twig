<!DOCTYPE html>
<html>
	<head>
		<meta charset="UTF-8"/>
		<title>
			{% block title %}
				BxlEvent
			{% endblock %}
		</title>
		<!-- Fonts -->
		<link href="https://fonts.googleapis.com" rel="preconnect"/>
		<link href="https://fonts.gstatic.com" rel="preconnect" crossorigin/>
		<link href="https://fonts.googleapis.com/css2?family=Roboto:ital,wght@0,100;0,300;0,400;0,500;0,700;0,900;1,100;1,300;1,400;1,500;1,700;1,900&family=Poppins:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&family=Raleway:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&display=swap" rel="stylesheet"/>
		<link
		rel="stylesheet" href="https://cdn.jsdelivr.net/gh/lipis/flag-icons@7.3.2/css/flag-icons.min.css"/>
		<!-- Vendor CSS Files -->
		<link href="{{asset('assets/vendor/bootstrap/css/bootstrap.min.css')}}" rel="stylesheet"/>
		<link href="{{asset('assets/vendor/bootstrap-icons/bootstrap-icons.css')}}" rel="stylesheet"/>
		<link href="{{asset('assets/css/main.css')}}" rel="stylesheet"/>
		 <script src="{{asset('assets/vendor/bootstrap/js/bootstrap.bundle.min.js')}}" defer></script>
		 <script src="{{asset('assets/js/main.js')}}" defer></script>
		<!-- Fin import folioOne -->{% block stylesheets %}
		{% endblock %}
			{% block javascripts %}
				{% block importmap %}
			{{ importmap('app') }}
		{% endblock %}
	{% endblock %}
	</head>
		<body>
			<header id="header" class="header d-flex align-items-center light-background sticky-top"> <div class="container position-relative d-flex align-items-center justify-content-between">
				<div class="d-flex align-items-center gap-4">
					<a href="{{ path('app_event_index') }}" class="logo d-inline-flex align-items-center text-decoration-none">
						<i class="bi bi-ticket-perforated-fill fs-4 me-2"></i>
						<span class="fs-4 fw-bold">BxlEvent</span>
					</a>
					<nav id="navmenu" class="navmenu">
						<ul>
							<li>
								<a href="{{ path('app_event_index') }}">{% trans %}Accueil{% endtrans %}</a>
							</li>
							<li>
								<a href="{{path('app_contact_about')}}">{% trans %}A propos{% endtrans %}</a>
							</li>
							<li class="dropdown">
								<a href="">
									<span>{% trans %}Catégories{% endtrans %}</span>
									<i class="bi bi-chevron-down toggle-dropdown"></i>
								</a>
								<ul>
									{% for categorie in categorie_repository.findAll() %}
										<li>
											<a href="{{ path('app_event_index', {category: categorie.id, filter_token: csrf_token('filter')}) }}#events-results">{{ categorie.name }}</a>
										</li>
									{% endfor %}
								</ul>
							</li>
							<li>
								<a href="{{ path('app_contact_contoller') }}">{% trans %}Contact{% endtrans %}</a>
							</li>
						</ul>
						<i class="mobile-nav-toggle d-xl-none bi bi-list"></i>
					</nav>
				</div>
				<div>
					<nav class="navmenu-right">
						<ul>
							<li class="p-0">
								<a href="{{ path('app_cart_index') }}" class="cart-link">
									<i class="bi bi-cart fs-5 me-1"></i>
									<span class="nav-label">{% trans %}Panier{% endtrans %}</span>
									{% if cart_service.getItemCount() > 0 %}
										<span class="cart-badge">{{ cart_service.getItemCount() }}</span>
									{% endif %}
								</a>
							</li>
							<li class="dropdown">
								<a href="">
									<i class="bi bi-person fs-5 me-1"></i>
									<span class="nav-label">{% trans %}Profil{% endtrans %}</span>
									<i class="bi bi-chevron-down toggle-dropdown"></i>
								</a>
								<ul>
									{% if not app.user %}

										<li>
											<a href="{{ path('app_login') }}">{% trans %}Connexion{% endtrans %}</a>
										</li>
										<li>
											<a href="{{ path('app_register') }}">{% trans %}Inscription{% endtrans %}</a>
										</li>
									{% else %}
										<li>
											<a href="{{ path('app_user_profil', {'id': app.user.id}) }}">{% trans %}Mon profil{% endtrans %}</a>
										</li>
										{% if  app.user.role.value =='admin' %}
											<li>
												<a href="{{ path('admin') }}">{% trans %}Administration{% endtrans %}</a>
											</li>
											<li>
												<a href="{{ path('app_mes_evenements') }}">{% trans %}Gestion des évènements{% endtrans %}</a>
											</li>
										{% endif %}
										{% if  app.user.role.value=='contributeur' %}
											<li>
												<a href="{{ path('app_mes_evenements') }}">{% trans %}Mes évènements{% endtrans %}</a>
											</li>
										{% endif %}
										<li>
											<a href="{{ path('app_logout') }}">{% trans %}Déconnexion{% endtrans %}</a>
										</li>
									{% endif %}
								</ul>
							</li>
							{% set flags = {'fr': 'fi-fr', 'en': 'fi-gb', 'nl': 'fi-nl', 'es': 'fi-es'} %}
							<li class="dropdown">
								<a href="">
									<span class="nav-label"><span class="fi {{ flags[app.request.locale]|default('fi-fr') }}"></span></span>
								</a>
								<ul>
									<li><a href="{{ path('app_change_locale', {'_locale': 'fr'}) }}" class="{{ app.request.locale == 'fr' ? 'active' : '' }}"><span class="fi fi-fr"></span></a></li>
									<li><a href="{{ path('app_change_locale', {'_locale': 'en'}) }}" class="{{ app.request.locale == 'en' ? 'active' : '' }}"><span class="fi fi-gb"></span></a></li>
									<li><a href="{{ path('app_change_locale', {'_locale': 'nl'}) }}" class="{{ app.request.locale == 'nl' ? 'active' : '' }}"><span class="fi fi-nl"></span></a></li>
									<li><a href="{{ path('app_change_locale', {'_locale': 'es'}) }}" class="{{ app.request.locale == 'es' ? 'active' : '' }}"><span class="fi fi-es"></span></a></li>
								</ul>
							</li>
						</li>
					</ul>
				</nav>

			</div>
		</div>
	</body>
</html></header>{% block body %}{% endblock %}<footer id="footer" class="footer mt-0">
<div class="container position-relative">
	<div class="row gy-4 justify-content-between">
		<div class="col-lg-4">
			<a href="{{ path('app_event_index') }}" class="d-inline-flex align-items-center text-decoration-none mb-3">
				<i class="bi bi-ticket-perforated-fill fs-2 me-2"></i>
				<span class="fs-3 fw-bold">BxlEvent</span>
			</a>
			<p>{% trans %}La billetterie qui réunit les meilleurs événements de Bruxelles, du showcase intime au grand festival.{% endtrans %}</p>
			<div class="footer-trust d-flex align-items-start gap-3 mt-4">
				<i class="bi bi-ticket-perforated"></i>
				<div>
					<p class="footer-trust-title mb-0">{% trans %}Billets sécurisés{% endtrans %}</p>
					<p class="footer-trust-subtitle mb-0">{% trans %}Achat 100% sécurisé{% endtrans %}</p>
				</div>
			</div>
			<div class="footer-trust d-flex align-items-start gap-3 mt-3">
				<i class="bi bi-headset"></i>
				<div>
					<p class="footer-trust-title mb-0">{% trans %}Support réactif{% endtrans %}</p>
					<p class="footer-trust-subtitle mb-0">{% trans %}Notre équipe est là pour vous{% endtrans %}</p>
				</div>
			</div>
			<div class="footer-trust d-flex align-items-start gap-3 mt-3">
				<i class="bi bi-patch-check"></i>
				<div>
					<p class="footer-trust-title mb-0">{% trans %}Événements vérifiés{% endtrans %}</p>
					<p class="footer-trust-subtitle mb-0">{% trans %}Qualité et fiabilité garanties{% endtrans %}</p>
				</div>
			</div>
		</div>
		<div class="col-lg-2 col-3">
			<h5 class="footer-title">{% trans %}Navigation{% endtrans %}</h5>
			<ul class="footer-links">
				<li>
					<a href="{{ path('app_event_index') }}">
						<i class="bi bi-chevron-right"></i>
						{% trans %}Accueil{% endtrans %}</a>
				</li>
				<li>
					<a href="{{ path('app_contact_contoller') }}">
						<i class="bi bi-chevron-right"></i>
						{% trans %}Contact{% endtrans %}</a>
				</li>
			</ul>
		</div>
		<div class="col-lg-2 col-4">
			<h5 class="footer-title">{% trans %}Mon compte{% endtrans %}</h5>
			<ul class="footer-links">
				<li>
					<a href="{{ path('app_login') }}">
						<i class="bi bi-chevron-right"></i>
						{% trans %}Connexion{% endtrans %}</a>
				</li>
				<li>
					<a href="{{ path('app_register') }}">
						<i class="bi bi-chevron-right"></i>
						{% trans %}S'inscrire{% endtrans %}</a>
				</li>
				<li>
					<a href="{{ path('app_cart_index') }}">
						<i class="bi bi-chevron-right "></i>
						{% trans %}Panier{% endtrans %}</a>
				</li>
			</ul>
		</div>
		<div class="col-lg-2 col-5">
			<h5 class="footer-title">{% trans %}Aide{% endtrans %}</h5>
			<ul class="footer-links">
				<li>
					<a href="{{ path('app_contact_faq') }}">
						<i class="bi bi-chevron-right"></i>
						{% trans %}FAQ{% endtrans %}</a>
				</li>
				<li>
					<a href="{{ path('app_terms') }}">
						<i class="bi bi-chevron-right"></i>
						{% trans %}Conditions générales{% endtrans %}</a>
				</li>
				<li>
					<a href="{{ path('app_privacy_policy') }}">
						<i class="bi bi-chevron-right"></i>
						{% trans %}Politique de confidentialité{% endtrans %}</a>
				</li>
				<li>
					<a href="{{ path('app_legal_notice') }}">
						<i class="bi bi-chevron-right"></i>
						{% trans %}Mentions légales{% endtrans %}</a>
				</li>
			</ul>
		</div>
		<div class="col-lg-3">
			<h5 class="footer-title">{% trans %}Suivez-nous{% endtrans %}</h5>
			<div class="social-links d-flex">
				<a href="#">
					<i class="bi bi-facebook"></i>
				</a>
				<a href="#">
					<i class="bi bi-instagram"></i>
				</a>
				<a href="#">
					<i class="bi bi-twitter-x"></i>
				</a>
				<a href="#">
					<i class="bi bi-linkedin"></i>
				</a>
			</div>
		</div>
	</div>
	<div class="footer-bottom d-flex flex-wrap justify-content-between align-items-center gap-3">
		<div class="footer-contact d-flex flex-wrap gap-4">
			<span>
				<i class="bi bi-geo-alt"></i>
				{% trans %}Bruxelles, Belgique{% endtrans %}</span>
			<span>
				<a href="mailto:contact@bxlevent.be">
					<i class="bi bi-envelope"></i>
					{% trans %}contact@bxlevent.be{% endtrans %}</a>
			</span>
			<span>
				<a href="tel:+3221234567">
					<i class="bi bi-telephone"></i>
					+32 2 123 45 67</a>
			</span>
		</div>
		<div class="footer-legal d-flex flex-wrap align-items-center gap-3">
			<p class="mb-0">&copy;
				{{ "now"|date('Y') }}
				<strong>BxlEvent</strong>.
				{% trans %}Tous droits réservés.{% endtrans %}</p>
			<a href="{{path('app_legal_notice')}}">{% trans %}Mentions légales{% endtrans %}</a>
		</div>
	</div>
</footer></body></html>
