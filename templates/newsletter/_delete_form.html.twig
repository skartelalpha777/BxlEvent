<form method="post" action="{{ path('app_newsletter_delete', {'id': newsletter.id}) }}" onsubmit="return confirm('{{ 'Are you sure you want to delete this item?'|trans|e('js') }}');">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ newsletter.id) }}">
    <button class="btn">{% trans %}Delete{% endtrans %}</button>
</form>
