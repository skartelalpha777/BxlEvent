{% extends 'base.html.twig' %}

{% block title %}{% trans %}Abonné newsletter{% endtrans %} | BxlEvent{% endblock %}

{% block body %}
    <h1>{% trans %}Newsletter{% endtrans %}</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>{% trans %}Id{% endtrans %}</th>
                <td>{{ newsletter.id }}</td>
            </tr>
            <tr>
                <th>{% trans %}Email{% endtrans %}</th>
                <td>{{ newsletter.email }}</td>
            </tr>
            <tr>
                <th>{% trans %}InscriptionDate{% endtrans %}</th>
                <td>{{ newsletter.inscriptionDate ? newsletter.inscriptionDate|date('Y-m-d') : '' }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_newsletter_index') }}">{% trans %}back to list{% endtrans %}</a>

    <a href="{{ path('app_newsletter_edit', {'id': newsletter.id}) }}">{% trans %}edit{% endtrans %}</a>

    {{ include('newsletter/_delete_form.html.twig') }}
{% endblock %}
