{% extends 'base.html.twig' %}

{% block title %}{% trans %}Newsletter{% endtrans %} | BxlEvent{% endblock %}

{% block body %}
    <h1>{% trans %}Newsletter index{% endtrans %}</h1>

    <table class="table">
        <thead>
            <tr>
                <th>{% trans %}Id{% endtrans %}</th>
                <th>{% trans %}Email{% endtrans %}</th>
                <th>{% trans %}InscriptionDate{% endtrans %}</th>
                <th>{% trans %}actions{% endtrans %}</th>
            </tr>
        </thead>
        <tbody>
        {% for newsletter in newsletters %}
            <tr>
                <td>{{ newsletter.id }}</td>
                <td>{{ newsletter.email }}</td>
                <td>{{ newsletter.inscriptionDate ? newsletter.inscriptionDate|date('Y-m-d') : '' }}</td>
                <td>
                    <a href="{{ path('app_newsletter_show', {'id': newsletter.id}) }}">{% trans %}show{% endtrans %}</a>
                    <a href="{{ path('app_newsletter_edit', {'id': newsletter.id}) }}">{% trans %}edit{% endtrans %}</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="4">{% trans %}no records found{% endtrans %}</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('app_newsletter_new') }}">{% trans %}Create new{% endtrans %}</a>
{% endblock %}
