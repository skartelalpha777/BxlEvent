{% extends 'base.html.twig' %}
{% block title %}{% trans %}FAQ{% endtrans %} | BxlEvent{% endblock %}
{% block body %}
	<main class="main">

		<section id="faq-head" class="FaqHead section">
			<div class="container-fluid container-lg text-center">
				<h1>{% trans %}Foire aux questions{% endtrans %}</h1>
				<div class="line mb-4 mx-auto"></div>
				<p class="fs-5">{% trans %}Retrouvez ici les réponses aux questions les plus fréquentes à propos de BxlEvent.{% endtrans %}</p>
			</div>
		</section>

		<section id="faq" class="section">
			<div class="container-fluid container-lg">

				<div class="accordion faq-accordion" id="faqAccordion">
					<div class="accordion-item">
						<h2 class="accordion-header">
							<button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#faq1">
								<span class="accordion-icon">
									<i class="bi bi-person"></i>
								</span>
								{% trans %}Comment créer un compte sur BxlEvent ?{% endtrans %}
							</button>
						</h2>
						<div id="faq1" class="accordion-collapse collapse show" data-bs-parent="#faqAccordion">
							<div class="accordion-body">
								{% trans %}Cliquez sur "S'inscrire" dans  de la page de connexion, remplissez le formulaire avec vos informations et validez votre inscription via l'e-mail que vous recevrez. Une fois votre compte activé, vous pourrez profiter de toutes les fonctionnalités.{% endtrans %}
							</div>
						</div>
					</div>

					<div class="accordion-item">
						<h2 class="accordion-header">
							<button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#faq2">
								<span class="accordion-icon">
									<i class="bi bi-ticket-perforated"></i>
								</span>
								{% trans %}Comment réserver un événement ?{% endtrans %}
							</button>
						</h2>
						<div id="faq2" class="accordion-collapse collapse" data-bs-parent="#faqAccordion">
							<div class="accordion-body">
								{% trans %}Rendez-vous sur la page de l'événement qui vous intéresse, choisissez votre type de billet et la quantité, puis ajoutez-le au panier. Vous pourrez ensuite finaliser votre commande depuis votre panier.{% endtrans %}
							</div>
						</div>
					</div>
					

					<div class="accordion-item">
						<h2 class="accordion-header">
							<button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#faq3">
								<span class="accordion-icon">
									<i class="bi bi-calendar-x"></i>
								</span>
								{% trans %}Puis-je annuler ou modifier ma réservation ?{% endtrans %}
							</button>
						</h2>
						<div id="faq3" class="accordion-collapse collapse" data-bs-parent="#faqAccordion">
							<div class="accordion-body">
						{% trans %}Les billets sont non remboursables sauf en cas d'annulation de l'événement.{% endtrans %}	</div>
						</div>
					</div>

					<div class="accordion-item">
						<h2 class="accordion-header">
							<button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#faq4">
								<span class="accordion-icon">
									<i class="bi bi-credit-card"></i>
								</span>
								{% trans %}Quels moyens de paiement acceptez-vous ?{% endtrans %}
							</button>
						</h2>
						<div id="faq4" class="accordion-collapse collapse" data-bs-parent="#faqAccordion">
							<div class="accordion-body">
								{% trans %}BxlEvent accepte les principales cartes bancaires ainsi que les moyens de paiement en ligne les plus courants. Toutes les transactions sont sécurisées.{% endtrans %}
							</div>
						</div>
					</div>

					<div class="accordion-item">
						<h2 class="accordion-header">
							<button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#faq5">
								<span class="accordion-icon">
									<i class="bi bi-bell"></i>
								</span>
								{% trans %}Comment être informé des nouveaux événements ?{% endtrans %}
							</button>
						</h2>
						<div id="faq5" class="accordion-collapse collapse" data-bs-parent="#faqAccordion">
							<div class="accordion-body">
								{% trans %}Inscrivez-vous à notre newsletter depuis la page d'accueil pour recevoir chaque semaine une sélection des meilleurs événements à ne pas manquer à Bruxelles.{% endtrans %}
							</div>
						</div>
					</div>

					<div class="accordion-item">
						<h2 class="accordion-header">
							<button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#faq6">
								<span class="accordion-icon">
									<i class="bi bi-shield-check"></i>
								</span>
								{% trans %}Mes données sont-elles sécurisées ?{% endtrans %}
							</button>
						</h2>
						<div id="faq6" class="accordion-collapse collapse" data-bs-parent="#faqAccordion">
							<div class="accordion-body">
								{% trans %}Oui. Vos données personnelles et vos paiements sont traités de manière sécurisée et ne sont jamais partagés avec des tiers sans votre consentement.{% endtrans %}
							</div>
						</div>
					</div>

					<div class="accordion-item">
						<h2 class="accordion-header">
							<button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#faq7">
								<span class="accordion-icon">
									<i class="bi bi-question-circle"></i>
								</span>
								{% trans %}Je n'ai pas trouvé la réponse à ma question, que faire ?{% endtrans %}
							</button>
						</h2>
						<div id="faq7" class="accordion-collapse collapse" data-bs-parent="#faqAccordion">
							<div class="accordion-body">
								{% trans %}N'hésitez pas à nous contacter directement via notre page de contact, notre équipe se fera un plaisir de vous répondre rapidement.{% endtrans %}
							</div>
						</div>
					</div>

					<div class="accordion-item">
						<h2 class="accordion-header">
							<button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#faq8">
								<span class="accordion-icon">
									<i class="bi bi-download"></i>
								</span>
								{% trans %}Comment télécharger mes billets ?{% endtrans %}
							</button>
						</h2>
						<div id="faq8" class="accordion-collapse collapse" data-bs-parent="#faqAccordion">
							<div class="accordion-body">
								{% trans %}Rendez-vous dans votre profil, section "Mes commandes & billets". Pour chaque commande payée, un bouton "Télécharger mes billets" vous permet de récupérer vos billets au format PDF.{% endtrans %}
							</div>
						</div>
					</div>

					<div class="accordion-item">
						<h2 class="accordion-header">
							<button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#faq9">
								<span class="accordion-icon">
									<i class="bi bi-megaphone"></i>
								</span>
								{% trans %}Comment devenir organisateur et publier mon propre événement ?{% endtrans %}
							</button>
						</h2>
						<div id="faq9" class="accordion-collapse collapse" data-bs-parent="#faqAccordion">
							<div class="accordion-body">
								{% trans %}Lors de votre inscription, choisissez le profil "Contributeur (Organisateur)". Vous pourrez ensuite publier vos propres événements et gérer votre programmation depuis votre compte.{% endtrans %}
							</div>
						</div>
					</div>

					<div class="accordion-item">
						<h2 class="accordion-header">
							<button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#faq10">
								<span class="accordion-icon">
									<i class="bi bi-flag"></i>
								</span>
								{% trans %}Comment signaler un problème avec un événement ?{% endtrans %}
							</button>
						</h2>
						<div id="faq10" class="accordion-collapse collapse" data-bs-parent="#faqAccordion">
							<div class="accordion-body">
								{% trans %}Si un événement vous semble incorrect, annulé ou frauduleux, vous pouvez le signaler directement depuis sa page. Notre équipe examine chaque signalement et vous tient informé du traitement de votre demande.{% endtrans %}
							</div>
						</div>
					</div>
				</div>
				<div class="row mt-4 newsletter-bar pre-footer d-flex align-items-center">
					<div class="col-2">
						<i class="bi bi-headset"></i>
					</div>
					<div class="col-12 col-lg-4 col-md-4">
						<h3 class="h5">{% trans %}Vous avez encore une question ?{% endtrans %}</h3>
						<p>{% trans %}Notre équipe est là pour vous aider. N'hésitez pas à nous contacter.{% endtrans %}</p>
					</div>
					<div class="col col-lg-3"></div>
					<div class="col-12 col-lg-3 col-md-4 ">
						<button class="button" onclick="window.location.href='{{path('app_contact_contoller')}}'">{% trans %}Nous contacter{% endtrans %}</button>
					</div>
				</div>

			</div>
		</section>

	</main>
{% endblock %}
