{% extends 'base.html.twig' %}
{% block title %}{% trans %}Mentions légales{% endtrans %} | BxlEvent{% endblock %}
{% block body %}
	<main class="main">
		<section id="legal-notice" class="section">
			<div class="container-fluid container-lg">
				<p class="goal">{% trans %}Informations légales{% endtrans %}</p>
				<h1>{% trans %}Mentions légales{% endtrans %}</h1>
				<div class="line mb-4"></div>
				<p class="texst-white-50">{% trans %}Dernière mise à jour :{% endtrans %}
					{{ "now"|date('d/m/Y') }}</p>
				<p>{% trans %}Cette page présente les informations relatives à l'éditeur et à l'hébergement du site BxlEvent.{% endtrans %}</p>
				<h2 class="mt-5">{% trans %}1. Éditeur du site{% endtrans %}</h2>
				<p>{% trans %}Le site BxlEvent a été développé dans le cadre d'un projet de formation à l'EPFC (École Pratique des Hautes Études Commerciales).{% endtrans %}</p>
				<p>
					{% trans %}Responsable de la publication : Mamadou Alpha Diallo{% endtrans %}
					<br>{% trans %}E-mail :{% endtrans %}
					<a href="mailto:3010madiallo@student.epfc.eu">{% trans %}3010madiallo@student.epfc.eu{% endtrans %}</a>
				</p>
				<h2 class="mt-5">{% trans %}2. Hébergement{% endtrans %}</h2>
				<p class="text-white-50">
					{% trans %}Nom de l'hébergeur :{% endtrans %}
					<br>{% trans %}Adresse :{% endtrans %}
					<br>{% trans %}Contact :{% endtrans %}
				</p>
				<h2 class="mt-5">{% trans %}3. Propriété intellectuelle{% endtrans %}</h2>
				<p>{% trans %}Les éléments originaux du site BxlEvent, notamment les textes, le logo, la mise en page et les éléments graphiques créés dans le cadre du projet, sont protégés par les règles applicables en matière de propriété intellectuelle. Toute reproduction ou utilisation non autorisée de ces éléments peut être interdite. Plus de détails dans nos{% endtrans %}
					<a href="{{ path('app_terms') }}">{% trans %}conditions générales{% endtrans %}</a>.</p>
				<h2 class="mt-5">{% trans %}4. Données personnelles{% endtrans %}</h2>
				<p>{% trans %}Le traitement des données personnelles collectées sur le site est détaillé dans notre{% endtrans %}
					<a href="{{ path('app_privacy_policy') }}">{% trans %}politique de confidentialité{% endtrans %}</a>.</p>
				<h2 class="mt-5">{% trans %}5. Nature du site{% endtrans %}</h2>
				<p>{% trans %}BxlEvent est un projet initialement réalisé dans le cadre d'une formation à l'EPFC, dont le déploiement sur un serveur accessible publiquement fait partie des exigences de la formation. Au-delà de ce cadre scolaire, BxlEvent a vocation à être exploité comme un service réel une fois le projet validé.{% endtrans %}</p>
				<h2 class="mt-5">{% trans %}6. Contact{% endtrans %}</h2>
				<p>{% trans %}Pour toute question relative à ces mentions légales, vous pouvez nous contacter via notre{% endtrans %}
					<a href="{{ path('app_contact_contoller') }}">{% trans %}page de contact{% endtrans %}</a>.</p>
			</div>
		</section>
	</main>
{% endblock %}
