{% extends 'base.html.twig' %}
{% block title %}{% trans %}À propos{% endtrans %} | BxlEvent{% endblock %}
{% block body %}
	<main class="main">
		<section id="about-head" class="AboutHead section">
			<div class="container-fluid">
				<div class="row d-flex">
					<div class="col-6 col-lg-4 ms-4">
						<h1>{% trans %}A propos de BxlEvent{% endtrans %}</h1>
						<div class="line mb-4"></div>
						<p class="fs-5">{% trans %}BxlEvent est une plateforme dédiée aux événements récréatifs à Bruxelles et dans ses environs.{% endtrans %}
							<br>{% trans %}Notre objectif est de vous aider à découvrir facilement les activités et sorties qui correspondent à vos envies.{% endtrans %}</p>
					</div>
				</div>
			</div>
		</section>
		<section id="about" class="about section">
			<div class="container-fluid container-lg">

				<div class="row">
					<div class=" col-lg-6 col-12 ">
						<div class="pictures picture-a rounded"></div>
					</div>
					<div class="col-lg-6 col-12 paragraph ">
						<p class="goal">{% trans %}Notre projet{% endtrans %}</p>
						<h2>{% trans %}Une plateforme pensée pour découvrir Bruxelles autrement{% endtrans %}</h2>
						<div class="line"></div>
						<p class="mt-4">{% trans %}BxlEvent a été développé dans le cadre d'un projet scolaire avec l'objectif de créer une plateforme permettant de centraliser différents événements récréatifs organisés à Bruxelles.{% endtrans %}
							<br>
							<br>
							{% trans %}Concerts, festivals, spectacles, expositions, événements sportifs ou encore activités de loisirs : notre plateforme rassemble différentes possibilités de sorties au même endroit.{% endtrans %}
							<br>
							<br>
							{% trans %}Nous avons voulu proposer une interface simple et intuitive afin que chacun puisse trouver rapidement un événement, consulter ses informations et découvrir de nouvelles activités.{% endtrans %}</p>
					</div>
				</div>
				<div class="row mt-4 reverse-column">
					<div class="col-lg-6 col-12 paragraph ">
						<p class="goal">{% trans %}Pourquoi BxlEvent ?{% endtrans %}</p>
						<h2>{% trans %}Bruxelles, une ville pleine d'événements{% endtrans %}</h2>
						<div class="line"></div>
						<p class="mt-4">{% trans %}Bruxelles propose de nombreuses activités tout au long de l'année. Pourtant, trouver un événement qui correspond à ses envies peut parfois nécessiter de consulter plusieurs sites.{% endtrans %}
							<br><br>
							{% trans %}BxlEvent a donc été imaginé pour simplifier cette recherche. Grâce aux catégories, aux filtres et aux informations détaillées de chaque événement, vous pouvez facilement explorer les sorties disponibles et préparer votre prochaine activité.{% endtrans %}</p>
					</div>
					<div class=" col-lg-6 col-12 ">
						<div class="pictures picture-b rounded"></div>
					</div>
				</div>
				<div class="mt-5">
					<p class="goal">{% trans %}Ce que vous pouvez trouver sur BxlEvent{% endtrans %}</p>
					<div class="row gy-4 mt-2">
						<div class="col-6 col-lg-3">
							<div class="discover-card">
								<div class="discover-icon">
									<i class="bi bi-music-note-beamed"></i>
								</div>
								<h3 class="h5">{% trans %}Concerts & festivals{% endtrans %}</h3>
								<p>{% trans %}Découvrez les artistes et événements musicaux qui se déroulent à Bruxelles.{% endtrans %}</p>
							</div>
						</div>
						<div class="col-6 col-lg-3">
							<div class="discover-card">
								<div class="discover-icon">
									<i class="bi bi-film"></i>
								</div>
								<h3 class="h5">{% trans %}Spectacles & culture{% endtrans %}</h3>
								<p>{% trans %}Théâtre, spectacles, expositions et autres rendez-vous culturels à ne pas manquer.{% endtrans %}</p>
							</div>
						</div>
						<div class="col-6 col-lg-3">
							<div class="discover-card">
								<div class="discover-icon">
									<i class="bi bi-trophy"></i>
								</div>
								<h3 class="h5">{% trans %}Sports & loisirs{% endtrans %}</h3>
								<p>{% trans %}Retrouvez les événements sportifs et activités de loisirs proposés dans la capitale.{% endtrans %}</p>
							</div>
						</div>
						<div class="col-6 col-lg-3">
							<div class="discover-card">
								<div class="discover-icon">
									<i class="bi bi-people-fill"></i>
								</div>
								<h3 class="h5">{% trans %}Sorties & activités{% endtrans %}</h3>
								<p>{% trans %}Des idées de sorties pour profiter de Bruxelles seul, entre amis ou en famille.{% endtrans %}</p>
							</div>
						</div>
					</div>
				</div>
				<div class="row align-items-center mt-5">
					<div class="col-lg-6">
						<p class="goal">{% trans %}Tout pour{% endtrans %}</p>
						<h2>{% trans %}Vous aider à trouver votre prochaine sortie{% endtrans %}</h2>
						<p class="mt-3">{% trans %}Nous avons à cœur de rendre la recherche d'événements plus simple, claire et plus agréable. BxlEvent permet de parcourir les événements selon différents critères comme la catégorie, la date ou le lieu afin de trouver plus rapidement une activité qui vous correspond.{% endtrans %}</p>
					</div>
					<div class="col-lg-6">
						<ul class="goal-checklist">
							<li>
								<i class="bi bi-check-circle-fill"></i>
								{% trans %}Une sélection d'événements récréatifs de qualité{% endtrans %}</li>
							<li>
								<i class="bi bi-check-circle-fill"></i>
								{% trans %}Des informations claires et mises à jour régulièrement{% endtrans %}</li>
							<li>
								<i class="bi bi-check-circle-fill"></i>
								{% trans %}Une interface simple, rapide et accessible à tous{% endtrans %}</li>
							<li>
								<i class="bi bi-check-circle-fill"></i>
								{% trans %}Un projet réalisé avec passion et envie d'apprendre{% endtrans %}</li>
						</ul>
					</div>
				</div>
				<div>
					<div class="row mt-4 newsletter-bar pre-footer d-flex align-items-center">
						<div class="col-2">
							<i class="bi bi-stars"></i>
						</div>
						<div class="col-12 col-lg-4 col-md-4">
							<h3 class="h5">{% trans %}Une sortie vous attend peut-être!{% endtrans %}</h3>
							<p>{% trans %}Parcourez les évènements disponibles à Bruxelles et trouvez votre prochaine activité en quelques clics{% endtrans %}</p>
						</div>
						<div class="col col-lg-3"></div>
						<div class="col-12 col-lg-3 col-md-4 ">
							<button class="button" onclick="window.location.href='{{path('app_event_index')}}'">{% trans %}Découvrez les évènements{% endtrans %}</button>
						</div>
					</div>
				</div>

			</div>
		</section>

	</main>
{% endblock %}
