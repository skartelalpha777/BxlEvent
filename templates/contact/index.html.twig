{% extends 'base.html.twig' %}

{% block title %}{% trans %}Contact{% endtrans %} | BxlEvent{% endblock %}
{% block metadescription %}{% trans %}Une question sur un évènement ou votre commande ? Contactez l'équipe BxlEvent, nous vous répondons dans les plus brefs délais.{% endtrans %}{% endblock %}

{% block body %}
	<main class="main">

		<section id="contact" class="contact section">


			<div class="container section-title">
				<h2>{% trans %}Contact{% endtrans %}</h2>
				<p>{% trans %}Une question sur un événement à Bruxelles ? Notre équipe vous répond dans les plus brefs délais.{% endtrans %}</p>
			</div>

			<div class="container-fluid container-lg">

				<div class="row g-4 g-lg-5">
					<div class="col-lg-5">
						<div class="info-box">
							<h3>{% trans %}Contact Info{% endtrans %}</h3>
							<p>{% trans %}Retrouvez-nous au cœur de la capitale ou contactez-nous directement.{% endtrans %}</p>

							<div class="info-item">
								<div class="icon-box">
									<i class="bi bi-geo-alt"></i>
								</div>
								<div class="content">
									<h4>{% trans %}Notre Localisation{% endtrans %}</h4>
									<p>{% trans %}Avenue de l'Astronomie 19 
																																																												1210 Saint-Josse{% endtrans %}</p>
								</div>
							</div>

							<div class="info-item">
								<div class="icon-box">
									<i class="bi bi-telephone"></i>
								</div>
								<div class="content">
									<h4>{% trans %}Téléphone{% endtrans %}</h4>
									<p>+1 5589 55488 55</p>
								</div>
							</div>

							<div class="info-item">
								<div class="icon-box">
									<i class="bi bi-envelope"></i>
								</div>
								<div class="content">
									<h4>{% trans %}Email{% endtrans %}</h4>
									<p>3010madiallo@student.epfc.eu</p>
								</div>
							</div>
						</div>
					</div>

					<div class="col-lg-7">
						<div class="contact-form">
							<h3>{% trans %}Envoyez un message{% endtrans %}</h3>


							{{ form_start(form, {'attr': {'class': 'php-email-form'}}) }}
							<div class="row gy-4">

								<div class="col-md-6">
									{{ form_widget(form.nom, {
                                        'attr': {
                                            'class': 'form-control', 
                                            'placeholder': 'Votre nom'
                                        }
                                    }) }}
									{{ form_errors(form.nom) }}
								</div>
								<div class="col-md-6">
									{{ form_widget(form.prenom, {
                                        'attr': {
                                            'class': 'form-control', 
                                            'placeholder': 'Votre prenom'
                                        }
                                    }) }}
									{{ form_errors(form.prenom) }}
								</div>

								<div class="col-12">
									{{ form_widget(form.email, {
                                        'attr': {
                                            'class': 'form-control', 
                                            'placeholder': 'Votre email'
                                        }
                                    }) }}
									{{ form_errors(form.email) }}
								</div>

								<div class="col-12">
									{{ form_widget(form.message, {
                                        'attr': {
                                            'class': 'form-control', 
                                            'placeholder': 'Message',
                                            'rows': 6
                                        }
                                    }) }}
									{{ form_errors(form.message) }}
								</div>

								<div class="col-12 text-center">
									<div class="loading">{% trans %}Chargement...{% endtrans %}</div>
									<div class="error-message"></div>
									<div class="sent-message">{% trans %}Votre message a été envoyé. Merci !{% endtrans %}</div>

									<button type="submit" class="btn button">{% trans %}Envoyer le message{% endtrans %}</button>
								</div>
								<div class="col-12 text-center">
									{% for message in app.flashes('success') %}
										<div class="alert alert-success">
											{{ message }}
										</div>
									{% endfor %}
								</div>

							</div>
							{{ form_end(form) }}


						</div>

						{% for message in app.flashes('success') %}
							<div class="alert alert-success alert-dismissible fade show" role="alert">
								{{ message }}
								<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="{{ 'Close'|trans }}"></button>
							</div>
						{% endfor %}
					</div>

				</div>

			</div>

		</section>
	</main>
{% endblock %}
