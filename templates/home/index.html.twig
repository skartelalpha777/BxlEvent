{% extends 'base.html.twig' %}

{% block title %}{% trans %}Accueil{% endtrans %} | BxlEvent{% endblock %}
{% block body %}
  <table class="table" border="1">
    <thead>
      <tr>
        <th>{% trans %}Id{% endtrans %}</th>
        <th>{% trans %}Title{% endtrans %}</th>
        <th>{% trans %}Description{% endtrans %}</th>
        <th>{% trans %}Date{% endtrans %}</th>
        <th>{% trans %}Hour{% endtrans %}</th>
      </tr>
    </thead>
    <tbody>

      {% for event in events %}
        <tr>
          <td>{{ event.id }}</td>
          <td>{{ event.title }}</td>
          <td>{{ event.getTranslatedDescription(app.request.locale) }}</td>
          <td>{{ event.date ? event.date|date('Y-m-d') : '' }}</td>
          <td>{{ event.hour ? event.hour|date('H:i:s') : '' }}</td>
        </tr>
      {% else %}
        <tr>
          <td colspan="7">{% trans %}no records found{% endtrans %}</td>
        </tr>
      {% endfor %}
    </tbody>
  </table>

{% endblock %}
