{% extends 'base.html.twig' %}

{% block title %}
	{% trans %}
	Accueil
	{% endtrans %}
	| BxlEvent
{% endblock %}

{% block body %}
	<main>

		{% set flashes = app.flashes %}
		{% if flashes|length > 0 %}
			<div class="container pt-4">
				{% for label, messages in flashes %}
					{% for message in messages %}
						<div class="alert alert-{{ label == 'error' ? 'danger' : 'success' }} d-flex align-items-center gap-2 text-center justify-content-center" role="alert">
							<i class="bi {{ label == 'error' ? 'bi-exclamation-triangle-fill' : 'bi-check-circle-fill' }}"></i>
							<span>{{ message }}</span>
						</div>
					{% endfor %}
				{% endfor %}
			</div>
		{% endif %}
		<section>
			<div class="container-fluid mb-0 pb-0">
				<div class="row main-home d-flex align-items-center justify-content-center text-center">
					<div class="col-10 col-md-8 col-lg-6 hero-content text-white">
						<h1 class="display-3 fw-bold">BxlEvent</h1>
						<div id="line"></div>
						<p class="fs-5 my-4">
							{% trans %}
							L'AGENDA DE VOS MEILLEURS SORTIES
							{% endtrans %}</p>
						<p class=" text-center fs-5 my-4">{% trans %}
							Concerts, expositions, festivals ou événements sportifs...
							<br>BxlEvent rassemble pour vous toutes les activités incontournables de la capitale.
							{% endtrans %}</p>

						<button class="button" id="featured-events" onclick="window.location.href=' {{path('app_events_featured')}} ' ">{% trans %}Découvrez les évènements à ne pas rater{% endtrans %}</button>
					</div>

				</div>
			</div>

		</section>


		<section class="hero section pb-0">
			<div class="container">
				<form class="event-filters" method="GET" action="{{ path('app_event_index') }}#events-results">
					<div class="row gy-3">
						<div class="col-md-6 col-lg">
							<label class="filter-label" for="filter-search">{% trans %}Recherche{% endtrans %}</label>
							<div class="filter-control">
								<i class="bi bi-search"></i>
								<input type="search" id="filter-search" name="search" placeholder="{{ 'Rechercher un événement...'|trans }}">
							</div>
						</div>

						<div class="col-md-6 col-lg">
							<label class="filter-label" for="filter-category">{% trans %}Catégories{% endtrans %}</label>
							<div class="filter-control">
								<i class="bi bi-grid"></i>
								<select id="filter-category" name="category">
									<option value="">{% trans %}Toutes les catégories{% endtrans %}</option>
									{% for categorie in categories %}
										<option value="{{categorie.id}}" {{ app.request.query.get('category') == categorie.id ? 'selected' : '' }}>{{categorie.name}}</option>
									{% endfor %}

								</select>
								<i class="bi bi-chevron-down chevron"></i>
							</div>
						</div>

						<div class="col-md-6 col-lg">
							<label class="filter-label" for="filter-date">{% trans %}Date{% endtrans %}</label>
							<div class="filter-control">
								<i class="bi bi-calendar-event"></i>
								<input type="date" id="filter-date" name="date">
							</div>
						</div>

						<div class="col-md-6 col-lg">
							<label class="filter-label" for="filter-location">{% trans %}Lieu{% endtrans %}</label>
							<div class="filter-control">
								<i class="bi bi-geo-alt"></i>
								<select id="filter-location" name="location">
									<option value="">{% trans %}Tous les lieux{% endtrans %}</option>
									{% for location in locations %}
										<option value="{{ location.id }}">{{ location.name }}</option>
									{% endfor %}
								</select>
								<i class="bi bi-chevron-down chevron"></i>
							</div>
						</div>

						<div class="col-md-6 col-lg">
							<label class="filter-label" for="filter-sort">{% trans %}Trier par{% endtrans %}</label>
							<div class="filter-control">
								<i class="bi bi-sort-down"></i>
								<select id="filter-sort" name="sort">
									<option value="ASC">{% trans %}Date croissante{% endtrans %}</option>
									<option value="DESC">{% trans %}Date décroissante{% endtrans %}</option>
								</select>
								<i class="bi bi-chevron-down chevron"></i>
							</div>
						</div>
					</div>

					<input type="hidden" name="filter_token" value="{{ csrf_token('filter') }}">

					<div class="text-center mt-4 d-flex justify-content-center align-items-center gap-3">
						<button type="submit" class="button">{% trans %}Appliquer{% endtrans %}</button>
						<a href="{{ path('app_event_index') }}" class="filter-reset">
							<i class="bi bi-arrow-counterclockwise"></i>
							{% trans %}Réinitialiser les filtres{% endtrans %}
						</a>
					</div>

				</form>
				<div id="events-results" class="row mt-4 mb-5 g-2 g-md-4">
					{% for event in events %}
						<div class="col-6 col-md-4 mt-4">
							<div class="card">
								{% if event.galleries is not empty %}

									<img src="{{ asset('assets/img/uploads/events/' ~ event.galleries[0].name) }}" class="card-img-top" alt="..." style="height: 220px; object-fit: cover;"/>
								{% else %}
									<img src="https://c8.alamy.com/compfr/2fa5h0c/icone-aucune-image-disponible-signe-d-image-manquant-ou-aucune-image-pour-le-site-web-ou-l-application-mobile-symbole-vectoriel-2fa5h0c.jpg" class="img-fluid rounded-3 w-100" style="object-fit: cover; max-height: 220px;" alt="{{ 'Image anonyme de l\'évènement'|trans }}">
								{% endif %}
								<div class="card-body mb-0 pb-0">
									{% for cat in event.categories %}
										<p class="categorie">{{cat.name}}</p>
									{% endfor %}
									<h4 class="card-title">{{ event.title }}</h4>
									<div class="event-date-badge position-absolute top-0 start-0 m-3 px-2 rounded text-white fw-bold" style="background:var(--accent-color);">
										{{ event.date|date('d M')|upper }}
									</div>

								</div>
								<ul class="list-group list-group-flush ">
									<li class="list-group-item">
										<i class="bi bi-geo-alt"></i>
										{% set adress = event.location.name ~','~ event.location.street ~'  '~ event.location.number ~','~ event.location.postcode ~' '~ event.location.city	%}
										{% set url = 'https://www.google.com/maps/search/?api=1&query=' ~ adress|url_encode%}

										<a href="{{url}}" target="_blank">{{event.location.name}}</a>
									</li>

									<li class="list-group-item ">
										<i class="bi bi-calendar-check-fill me-1"></i>
										{{event.date|date('d M Y') }}
									</li>
									<li class="list-group-item ">
										<i class="bi bi-alarm"></i>
										{{ event.hour|date('H:i') }}</li>
								</ul>
								<div class="card-body">
									<div class="row card-actions">
										<div class="col">
											<button class="button w-100" type="button" onclick="window.location.href='{{path('app_event_tickets',{id:event.id})}}'">{% trans %}Voir les tickets{% endtrans %}</button>
										</div>
										<div class="col text-end">
											<button class=" noBackground px-4" type="button" onclick="window.location.href=' {{path('app_event_consult', {id:event.id} )}}'">{% trans %}Voir l'évènement{% endtrans %}</button>
										</div>
									</div>


								</div>


							</div>
						</div>
					{% endfor %}


				</div>
			</div>
		</section>
		<div class="navigation  mb-4">
			{{ knp_pagination_render(events) }}
		</div>

		<section class="newlstter pt-0">
			<div class="container-fluid p-0  newsletter mt-0">
				<div class="row   d-flex align-items-center justify-content-center text-center">
					<div class="col my-5">
						<h2>{% trans %}Ne manquez aucune sortie{% endtrans %}</h2>
						<p>{% trans %}Inscrivez-vous à notre newsletter{% endtrans %}</p>
						<form name="frmNewsletter" action="{{path('app_newSuscrib_new')}}" method="post">
							<div class="input-group justify-content-center">
								<input type="email" name="email" id="email" placeholder="{{ 'Email'|trans }}" class="form-control rounded" style="max-width: 300px;">
								<button type="submit" class="button ms-2 ">{% trans %}S'abonner{% endtrans %}</button>
								<input type="hidden" name="_token" value="{{ csrf_token('newsletter_token') }}">
							</div>
						</form>

					</div>
				</div>


			</div>
		</section>
	</main>
	 <script src="{{ asset('assets/vendor/aos/aos.js') }}"></script>
{# 2. Initialisation obligatoire pour activer les animations #}
	 <script>
																											AOS.init({duration: 1000, easing: 'smart', once: true, mirror: false})
																										</script>
{% endblock %}
