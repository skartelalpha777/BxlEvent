{% extends 'base.html.twig' %}

{% block title %}{% trans %}Mon tableau de bord{% endtrans %} | BxlEvent{% endblock %}

{% block body %}
	<section class="pt-5 pb-5">
		<div class="container-fluid container-lg">

			<div class="row g-4">
				<div class="col-lg-3">
					<div class="dash-card p-4 text-center mb-4">
						<a href="{{path('app_user_profil',{'id':app.user.id})}}">
							<img class="rounded-circle mb-3" width="90" height="90" style="object-fit: cover;" src="{{ app.user.profileImg ?: 'https://static.vecteezy.com/ti/vecteur-libre/p1/26625600-la-personne-icone-vecteur-symbole-conception-illustration-vectoriel.jpg' }}" alt="{{ 'Photo de profil'|trans }}">
						</a>
						<h5 class="mb-1">{{ app.user.firstName }}
							{{ app.user.lastName }}</h5>
						<span class="dash-badge mb-2 d-inline-block">{% trans %}Contributeur{% endtrans %}</span>
						<p class="small  mb-0">{{ app.user.email }}</p>
					</div>
					<div class="dash-card p-2">
						<nav class="nav flex-column dash-nav">
							<a class="nav-link active" href="{{ path('app_mes_evenements') }}">
								<i class="bi bi-grid-1x2-fill"></i>
								{% trans %}Vue d'ensemble{% endtrans %}
							</a>
							<a class="nav-link" href="{{ path('app_mes_statistiques') }}">
								<i class="bi bi-bar-chart-fill"></i>
								{% trans %}Statistiques{% endtrans %}
							</a>
							<a class="nav-link" href="{{ path('app_reports_index') }}">
								<i class="bi bi-flag-fill"></i>
								{% trans %}Signalements{% endtrans %}
							</a>
						</nav>
					</div>
				</div>
				<div class="col-lg-9">
					<div class="mb-4">
						<h2 class="mb-1">{% trans %}Bonjour{% endtrans %}
							{{ app.user.firstName }}
						</h2>
						<p class="mb-0">{% trans %}Voici un aperçu de votre activité sur BxlEvent.{% endtrans %}</p>
					</div>
					<div class="row g-3 mb-4">
						<div class="col-6 col-md-3">
							<div class="dash-card p-3 h-100">
								<div class="newsletter-icon mb-2">
									<i class="bi bi-ticket-perforated-fill"></i>
								</div>
								<div class="fs-4 fw-bold">{{ totalTickets }}</div>
								<p class="small">{% trans %}Billets vendus{% endtrans %}</p>
							</div>
						</div>
						<div class="col-6 col-md-3">
							<div class="dash-card p-3 h-100">
								<div class="newsletter-icon mb-2">
									<i class="bi bi-currency-euro"></i>
								</div>
								<div class="fs-4 fw-bold">{{ revenu|number_format(0, ',', ' ') }}
									€</div>
								<p class="small">{% trans %}Revenus générés{% endtrans %}</p>
							</div>
						</div>
						<div class="col-6 col-md-3">
							<div class="dash-card p-3 h-100">
								<div class="newsletter-icon mb-2">
									<i class="bi bi-calendar-event-fill"></i>
								</div>
								<div class="fs-4 fw-bold">{{ myEvents|length }}</div>
								<p class="small">{% trans %}Événements créés{% endtrans %}</p>
							</div>
						</div>
						<div class="col-6 col-md-3">
							<div class="dash-card p-3 h-100">
								<div class="newsletter-icon mb-2">
									<i class="bi bi-flag-fill"></i>
								</div>
								<div class="fs-4 fw-bold">{{ reportsCount }}</div>
								<p class="small">{% trans %}Signalements reçus{% endtrans %}</p>
							</div>
						</div>
					</div>
					<div class="row g-3 mb-4">
						<div class="col-md-4">
							<div class="dash-card p-3 h-100 d-flex align-items-center justify-content-between">
								<span>
									<i class="bi bi-calendar-check text-success me-2"></i>{% trans %}Événements à venir{% endtrans %}</span>
								<span class="fs-5 fw-bold">{{ upcomingCount }}</span>
							</div>
						</div>
						<div class="col-md-4">
							<div class="dash-card p-3 h-100 d-flex align-items-center justify-content-between">
								<span>
									<i class="bi bi-calendar-event text-warning me-2"></i>{% trans %}Événements passés{% endtrans %}</span>
								<span class="fs-5 fw-bold">{{ pastCount }}</span>
							</div>
						</div>
						<div class="col-md-4">
							<div class="dash-card p-3 h-100 d-flex align-items-center justify-content-between">
								<span>
									<i class="bi bi-calendar-x text-danger me-2"></i>{% trans %}Événements réfusés{% endtrans %}</span>
								<span class="fs-5 fw-bold">{{ refused }}</span>
							</div>
						</div>
					</div>
					<div class="dash-card p-4">
						<div class="d-flex justify-content-between align-items-center mb-3">
							<h5 class="mb-0">{% trans %}Mes événements{% endtrans %}</h5>
						</div>
						{% if myEvents|length == 0 %}
							<p class="text-white-50 mb-0">{% trans %}Vous n'avez pas encore créé d'événement.{% endtrans %}</p>
						{% else %}
							<div class="table-responsive">
								<table class="table event-table border-0 align-middle mb-0">
									<thead>
										<tr>
											<th>{% trans %}Événement{% endtrans %}</th>
											<th>{% trans %}Date{% endtrans %}</th>
											<th>{% trans %}Lieu{% endtrans %}</th>
											<th>{% trans %}Statut{% endtrans %}</th>
											<th>{% trans %}Ventes{% endtrans %}</th>
											<th>{% trans %}Affiche{% endtrans %}</th>
										</tr>
									</thead>
									<tbody>
										{% for event in myEvents %}
											<tr>
												<td>
													<a href="{{path('app_event_show',{'id':event.id})}}">{{ event.title }}
												</td>
												<td class="text-white-50">{{ event.date|date('d M Y') }}</td>
												<td class="text-white-50">{{ event.location ? event.location.name : '—' }}</td>
												<td>
													{% if event.status.value == 'refused' %}
														<span class="badge text-bg-danger">{% trans %}Réfusé{% endtrans %}</span>
													{% elseif event.status.value == 'notchecked' %}
														<span class="badge text-bg-warning">{% trans %}En cours d'examen{% endtrans %}</span>
													{% elseif event.date < date() %}
														<span class="badge text-bg-warning">{% trans %}Passé{% endtrans %}</span>
													{% else %}
														<span class="badge text-bg-success">{% trans %}À venir{% endtrans %}</span>
													{% endif %}
												</td>
												<td>
													{% if event.status.value != 'notchecked' and event.status.value != 'refused' %}
														<a href="{{path('app_event_statistiques',{'eventId':event.id})}}">{% trans %}Voir les Statistiques{% endtrans %}</a>
													{% endif %}
												</td>
												<td>
													{% if event.status.value != 'notchecked' and event.status.value != 'refused' %}
														<a href="{{path('app_event_consult',{'id':event.id})}}">{% trans %}Voir l'affiche{% endtrans %}</a>
													{% endif %}
												</td>
												
											</tr>
										{% endfor %}
									</tbody>
								</table>
							</div>
						{% endif %}
					</div>
					<button class="button mt-4" onclick="window.location.href='{{path('app_event_new') }} '">{% trans %}Créer un évènement{% endtrans %}</button>
				</div>
			</div>
		</div>
	</section>
{% endblock %}
