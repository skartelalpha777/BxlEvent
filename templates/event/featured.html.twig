{% extends 'base.html.twig' %}
{% block title %}
	{% trans %}Évènements à ne pas rater{% endtrans %}
	| BxlEvent
{% endblock %}
{% block metadescription %}
	{% trans %}La sélection des évènements incontournables à Bruxelles : les concerts, festivals et sorties les plus populaires du moment, à ne pas manquer.{% endtrans %}
{% endblock %}
{% block body %}
	<main class="main">
		<div class="container-fluid">
			<div class="row featureEventsHead">
				<div class="col-lg-2 d-none d-lg-block"></div>
				<div class="col-12 col-lg-8 d-flex flex-column align-items-center justify-content-center">
					<h1>{% trans %}Evènements à ne pas rater{% endtrans %}</h1>
					<div id="line"></div>
					<p class="text-center fs-5 mt-2">
						{% trans %}
						Découvrez les événements incontournables de Bruxelles
						            Concerts, festivals, expositions, spectacles, événements sportifs ou activités en famille :
						            retrouvez chaque semaine notre sélection des meilleures sorties à Bruxelles et dans les environs.
						            Réservez vos billets en quelques clics grâce à BxlEvent.
						{% endtrans %}
					</p>
				</div>

				<div class="col-lg-2 d-none d-lg-block"></div>
			</div>
		</div>
		<section id="hero">
			<div class="container container-lg mt-0">
				<p>{% trans %}Notre équipe sélectionne les événements les plus populaires et les meilleures nouveautés afin de vous aider à trouver votre prochaine sortie. Que vous soyez amateur de musique, de culture ou de sport, il y en a pour tous les goûts.{% endtrans %}</p>
				<div class="row mt-4 mb-5 g-2 g-md-4">
					<h2>{{ events | length  }}
						{% trans %}Evènements{% endtrans %}</h2>
					{% if events | length == 0 %}
						<p>{% trans %}Aucun événement pour le moment, veillez revenir plus tard{% endtrans %}</p>
					{% endif %}

					{% for event in events %}
						<div class="col-6 col-md-4 mt-4">
							<div class="card">
								{% if event.galleries|length > 0 %}
									<img src="{{ asset('assets/img/uploads/events/' ~ event.galleries[0].name) }}" class="card-img-top" alt="image de l'évènement{{ event.title }}" style="height: 220px; object-fit: cover;"/>
								{% endif %}
								<div class="card-body mb-0 pb-0">
									{% for cat in event.categories %}
										<p class="categorie">{{cat.name}}</p>
									{% endfor %}
									<h4 class="card-title">{{ event.title }}</h4>
									<div class="event-date-badge position-absolute top-0 start-0 m-3 px-2 rounded text-white fw-bold" style="background:var(--accent-color);">
										{{ event.date|date('d M')|upper }}
									</div>
								</div>
								<ul class="list-group list-group-flush ">
									<li class="list-group-item">
										<i class="bi bi-geo-alt"></i>
										{% set adress = event.location.name ~','~ event.location.street ~'  '~ event.location.number ~','~ event.location.postcode ~' '~ event.location.city	%}
										{% set url = 'https://www.google.com/maps/search/?api=1&query=' ~ adress|url_encode%}
										<a href="{{url}}" target="_blank">{{event.location.name}}</a>
									</li>
									<li class="list-group-item ">
										<i class="bi bi-calendar-check-fill me-1"></i>
										{{event.date|date('d M Y') }}
									</li>
									<li class="list-group-item ">
										<i class="bi bi-alarm"></i>
										{{ event.hour|date('H:i') }}</li>
								</ul>
								<div class="card-body">
									<div class="row card-actions">
										<div class="col">
											<button class="button w-100" type="button" onclick="window.location.href='{{path('app_event_tickets',{id:event.id})}}'">{% trans %}Voir les tickets{% endtrans %}</button>
										</div>
										<div class="col text-end">
											<button class="noBackground px-4" type="button" onclick="window.location.href='{{path('app_event_consult', {id:event.id} )}}'">{% trans %}Voir l'évènement{% endtrans %}</button>
										</div>
									</div>
								</div>
							</div>
						</div>
					{% endfor %}
				</div>
				<div class="row  pre-footer event-filters ">
					<div class="col-md-6 ">
						<div class="row ">
							<div class="col-2">
								<i class="bi bi-star icon"></i>
							</div>
							<div class="col-10">
								<h3 class="fs-5 title">{% trans %}Selection exclusive{% endtrans %}</h3>
								<p>{% trans %}Les meilleurs évènements choisis pour vous{% endtrans %}</p>
							</div>
						</div>
					</div>
					<div class="col-md-6">
						<div class="row gx-2">
							<div class="col-2 d-flex align-items-centers">
								<i class="bi bi-hand-thumbs-up icon"></i>
							</div>
							<div class="col-8">
								<h3 class="fs-5 title">{% trans %}Billets sécurisés{% endtrans %}</h3>
								<p>{% trans %}Achats à 100% sécurisés et garantis{% endtrans %}</p>
							</div>
						</div>
					</div>
					<div class="col-md-6">
						<div class="row gx-2">
							<div class="col-2 d-flex align-items-center">
								<i class="bi bi-headset icon"></i>
							</div>
							<div class="col-8">
								<h3 class="fs-5 title">{% trans %}Support réactif{% endtrans %}</h3>
								<p>{% trans %}Notre équipe est là pour vous aider{% endtrans %}</p>
							</div>
						</div>
					</div>
					<div class="col-md-6">
						<div class="row gx-2">
							<div class="col-2 d-flex align-items-center">
								<i class="bi bi-calendar-event icon"></i>
							</div>
							<div class="col-8">
								<h3 class="fs-5 title">{% trans %}Mise à jour courante{% endtrans %}</h3>
								<p>{% trans %}De nouveaux évènements chaque semaine{% endtrans %}</p>
							</div>
						</div>
					</div>
				</div>
				<div class="newsletter-bar d-flex flex-wrap align-items-center justify-content-between gap-4 mt-4">
					<div class="d-flex align-items-center gap-3">
						<div class="newsletter-icon">
							<i class="bi bi-envelope"></i>
						</div>
						<div>
							<h3 class="h5 mb-1">{% trans %}Ne manquez aucune sortie !{% endtrans %}</h3>
							<p class="mb-0 small">{% trans %}Inscrivez-vous à notre newsletter et recevez chaque semaine les événements à ne pas rater.{% endtrans %}</p>
						</div>
					</div>
					<form name="frmNewsletter" action="{{ path('app_newSuscrib_new') }}" method="post" class="d-flex gap-2">
						<input type="email" name="email" id="email" placeholder="{{ 'Votre e-mail'|trans }}" class="form-control newsletter-input">
						<button type="submit" class="button">{% trans %}S'abonner{% endtrans %}</button>
						<input type="hidden" name="_token" value="{{ csrf_token('newsletter_token') }}">
					</form>
				</div>
			</div>
		</section>

	</main>
{% endblock %}
