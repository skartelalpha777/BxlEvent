{% extends 'base.html.twig' %}

{% block title %}{% trans %}Utilisateurs{% endtrans %} | BxlEvent
{% endblock %}

{% block body %}
	<h1>{% trans %}User index{% endtrans %}</h1>

	<table class="table">
		<thead>
			<tr>
				<th>{% trans %}Id{% endtrans %}</th>
				<th>{% trans %}Email{% endtrans %}</th>
				<th>{% trans %}FirstName{% endtrans %}</th>
				<th>{% trans %}LastName{% endtrans %}</th>
				<th>{% trans %}ProfileImg{% endtrans %}</th>
				<th>{% trans %}DateRgpd{% endtrans %}</th>
				<th>{% trans %}Role{% endtrans %}</th>
				<th>{% trans %}actions{% endtrans %}</th>
			</tr>
		</thead>
		<tbody>
			{% for user in users %}
				<tr>
					<td>{{ user.id }}</td>
					<td>{{ user.email }}</td>
					<td>{{ user.firstName }}</td>
					<td>{{ user.lastName }}</td>
					<td>{{ user.profileImg }}</td>
					<td>{{ user.dateRgpd ? user.dateRgpd|date('Y-m-d') : '' }}</td>
					<td>{{ user.role.value }}</td>
					<td>
						<a href="{{ path('app_user_show', {'id': user.id}) }}">{% trans %}show{% endtrans %}</a>
						<a href="{{ path('app_user_edit', {'id': user.id}) }}">{% trans %}edit{% endtrans %}</a>
					</td>
				</tr>
			{% else %}
				<tr>
					<td colspan="10">{% trans %}no records found{% endtrans %}</td>
				</tr>
			{% endfor %}
		</tbody>
	</table>

	<a href="{{ path('app_user_new') }}">{% trans %}Create new{% endtrans %}</a>
{% endblock %}
