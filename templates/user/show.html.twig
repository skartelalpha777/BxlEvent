{% extends 'base.html.twig' %}

{% block title %}{% trans %}Utilisateur{% endtrans %} | BxlEvent{% endblock %}

{% block body %}
    <h1>{% trans %}User{% endtrans %}</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>{% trans %}Id{% endtrans %}</th>
                <td>{{ user.id }}</td>
            </tr>
            <tr>
                <th>{% trans %}Email{% endtrans %}</th>
                <td>{{ user.email }}</td>
            </tr>
            <tr>
                <th>{% trans %}Roles{% endtrans %}</th>
                <td>{{ user.roles ? user.roles|json_encode : '' }}</td>
            </tr>
            <tr>
                <th>{% trans %}Password{% endtrans %}</th>
                <td>{{ user.password }}</td>
            </tr>
            <tr>
                <th>{% trans %}FirstName{% endtrans %}</th>
                <td>{{ user.firstName }}</td>
            </tr>
            <tr>
                <th>{% trans %}LastName{% endtrans %}</th>
                <td>{{ user.lastName }}</td>
            </tr>
            <tr>
                <th>{% trans %}ProfileImg{% endtrans %}</th>
                <td>{{ user.profileImg }}</td>
            </tr>
            <tr>
                <th>{% trans %}DateRgpd{% endtrans %}</th>
                <td>{{ user.dateRgpd ? user.dateRgpd|date('Y-m-d') : '' }}</td>
            </tr>
            <tr>
                <th>{% trans %}Role{% endtrans %}</th>
                <td>{{ user.role.value }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_user_index') }}">{% trans %}back to list{% endtrans %}</a>

    <a href="{{ path('app_user_edit', {'id': user.id}) }}">{% trans %}edit{% endtrans %}</a>

    {{ include('user/_delete_form.html.twig') }}
{% endblock %}
