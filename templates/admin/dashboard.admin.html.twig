{% extends '@EasyAdmin/page/content.html.twig' %}

{% block page_title %}
	Amministration
{% endblock %}

{% block main %}
	<div class="dashboard-page">
		<div class="row g-3 mb-3">
			{% for stat in kpis %}
				<div class="col-6 col-lg-3">
					<div class="card border-0 shadow-sm h-100">
						<div class="card-body d-flex align-items-start gap-3">
							<div class="rounded-circle d-flex align-items-center justify-content-center text-white flex-shrink-0" style="width: 44px; height: 44px; background: {{ stat.color }};">
								<i class="fas {{ stat.icon }}"></i>
							</div>
							<div>
								<div class="small text-uppercase text-muted fw-semibold">{{ stat.label }}</div>
								<div class="d-flex align-items-baseline gap-2">
									<span class="fs-4 fw-bold">{{ stat.value }}</span>
									<span class="small fw-semibold {{ stat.trend < 0 ? 'text-danger' : 'text-success' }}">
										<i class="fas {{ stat.trend < 0 ? 'fa-arrow-down' : 'fa-arrow-up' }}"></i>
										{{ stat.trend|abs }}%
									</span>
								</div>
								<div class="small text-muted">vs période précédente</div>
							</div>
						</div>
					</div>
				</div>
			{% endfor %}
		</div>

		<div class="row g-3 mb-3">
			<div class="col-12 col-md-6">
				<a href="{{ path('admin_event_index') }}" class="card border-0 border-start border-4 shadow-sm text-decoration-none text-reset" style="border-left-color: #1387c1 !important;">
					<div class="card-body">
						<div class="fs-3 fw-bold" style="color: #1387c1;">{{ pendingEventsCount }}</div>
						<div class="small text-muted">Évènement{{ pendingEventsCount > 1 ? 's' : '' }}
							en attente de validation</div>
					</div>
				</a>
			</div>
			<div class="col-12 col-md-6">
				<a href="{{ path('admin_reports_index') }}" class="card border-0 border-start border-4 shadow-sm text-decoration-none text-reset" style="border-left-color: #1387c1 !important;">
					<div class="card-body">
						<div class="fs-3 fw-bold" style="color: #1387c1;">{{ untreatedReportsCount }}</div>
						<div class="small text-muted">Signalement{{ untreatedReportsCount > 1 ? 's' : '' }}
							non traité{{ untreatedReportsCount > 1 ? 's' : '' }}</div>
					</div>
				</a>
			</div>
		</div>

		<div class="row g-3 mb-3">
			<div class="col-12 col-lg-6">
				<div class="card border-0 shadow-sm">
					<div class="card-body">
						<h3 class="fs-6 fw-semibold border-bottom pb-2 mb-3" style="color: #1387c1;">Utilisateurs inscrits par mois</h3>
						{{ render_chart(userByMonth) }}
					</div>
				</div>
			</div>
			<div class="col-12 col-lg-6">
				<div class="card border-0 shadow-sm">
					<div class="card-body">
						<h3 class="fs-6 fw-semibold border-bottom pb-2 mb-3" style="color: #1387c1;">Chiffre d'affaires par mois</h3>
						{{ render_chart(revenuByMonth) }}
					</div>
				</div>
			</div>
			<div class="col-12 col-lg-6">
				<div class="card border-0 shadow-sm">
					<div class="card-body">
						<h3 class="fs-6 fw-semibold border-bottom pb-2 mb-3" style="color: #1387c1;">Top catégories</h3>
						{{ render_chart(topCategories) }}
					</div>
				</div>
			</div>
		</div>
	</div>

{% endblock %}
