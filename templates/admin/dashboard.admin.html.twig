{% extends '@EasyAdmin/page/content.html.twig' %}

{% block page_title %}
	Amministration
{% endblock %}

{% block main %}
	<div class="dashboard-page">
		<form class="event-filters mb-3" method="GET" action="{{ path('admin') }}">
			<div class="row gy-3">
				<div class="col-md-6 col-lg">
					<label class="filter-label" for="filter-date">Date de début</label>
					<div class="filter-control">
						<i class="bi bi-calendar-event"></i>
						<input type="datetime-local" name="start-date">
					</div>
				</div>
				<div class="col-md-6 col-lg">
					<label class="filter-label" for="filter-date">Date de fin
					</label>
					<div class="filter-control">
						<i class="bi bi-calendar-event"></i>
						<input type="datetime-local" name="end-date">
					</div>
				</div>
			</div>
			<input type="hidden" name="filter_token" value="{{ csrf_token('filter') }}">
			<div class="text-center mt-4 d-flex justify-content-center align-items-center gap-3">
				<button type="submit" class="button">Appliquer</button>
				<a href="{{ path('admin') }}">
					<i class="bi bi-arrow-counterclockwise"></i>
					Réinitialiser les filtres
				</a>
			</div>
		</form>

		<div class="row g-3 mb-3">
			{% for stat in kpis %}
				<div class="col-6 col-lg-3">
					<div class="card border-0 shadow-lg  bg-body-tertiary">
						<div class="card-body d-flex align-items-start gap-3">
							<div class="rounded-circle d-flex align-items-center justify-content-center text-white flex-shrink-0" style="width: 44px; height: 44px; background: {{ stat.color }};">
								<i class="fas {{ stat.icon }}"></i>
							</div>
							<div>
								<div class="small title text-uppercase fw-semibold">{{ stat.label }}</div>
								<div class="d-flex align-items-baseline gap-2">
									<span class="fs-4 fw-bold">{{ stat.value }}</span>
									<span class="small fw-semibold {{ stat.trend < 0 ? 'text-danger' : 'text-success' }}">
										<i class="fas {{ stat.trend < 0 ? 'fa-arrow-down' : 'fa-arrow-up' }}"></i>
										{{ stat.trend|abs }}%
									</span>
								</div>
								<div class="small text-muted">vs période précédente</div>
							</div>
						</div>
					</div>
				</div>
			{% endfor %}
		</div>

		<div class="row g-3 mb-3">
			<div class="col-12 col-md-6">
				<a href="{{ path('admin_event_index') }}" class="card border-0  border-4 shadow-lg bg-body-tertiary text-decoration-none text-reset" >
					<div class="card-body">
						<div class="title fs-3 fw-bold" >{{ pendingEventsCount }}</div>
						<div class="small text-muted">Évènement{{ pendingEventsCount > 1 ? 's' : '' }}
							en attente de validation</div>
					</div>
				</a>
			</div>
			<div class="col-12 col-md-6">
				<a href="{{ path('admin_reports_index') }}" class="card border-0  border-4 shadow-lg bg-body-tertiary text-decoration-none text-reset">
					<div class="card-body">
						<div class="title fs-3 fw-bold" >{{ untreatedReportsCount }}</div>
						<div class="small text-muted">Signalement{{ untreatedReportsCount > 1 ? 's' : '' }}
							non traité{{ untreatedReportsCount > 1 ? 's' : '' }}</div>
					</div>
				</a>
			</div>
		</div>

		<div class="row g-3 mb-3">
			<div class="col-12 col-lg-6">
				<div class="card border-0 shadow-lg bg-body-tertiary bg-body-tertiary">
					<div class="card-body">
						<h3 class="title fs-6 fw-semibold border-bottom pb-2 mb-3" >Utilisateurs inscrits par mois</h3>
						{{ render_chart(userByMonth) }}
					</div>
				</div>
			</div>
			<div class="col-12 col-lg-6">
				<div class="card border-0 shadow-lg bg-body-tertiary">
					<div class="card-body">
						<h3 class="title fs-6 fw-semibold border-bottom pb-2 mb-3" >Chiffre d'affaires par mois</h3>
						{{ render_chart(revenuByMonth) }}
					</div>
				</div>
			</div>
			<div class="col-12 col-lg-6">
				<div class="card border-0 shadow-lg bg-body-tertiary">
					<div class="card-body">
						<h3 class="title fs-6 fw-semibold border-bottom pb-2 mb-3" >Top catégories</h3>
						{{ render_chart(topCategories) }}
					</div>
				</div>
			</div>
		</div>
	</div>
	<style>

		.title {
			color: #1387c1;
		}

		.event-filters {
			background: var(--bs-tertiary-bg);
			border: 1px solid var(--bs-border-color);
			border-radius: 1rem;
			padding: 1.75rem;
		}

		.event-filters .filter-label {
			display: block;
			font-weight: 600;
			font-size: 0.9rem;
			margin-bottom: 0.5rem;
		}

		.event-filters .filter-control {
			display: flex;
			align-items: center;
			gap: 0.6rem;
			background: var(--bs-body-bg);
			border: 1px solid var(--bs-border-color);
			border-radius: 0.6rem;
			padding: 0.65rem 0.9rem;
			transition: 0.3s;
		}

		.event-filters .filter-control:focus-within {
			border-color: #1387c1;
		}

		.event-filters .filter-control>i:first-child {
			color: #1387c1;
			font-size: 1rem;
		}

		.event-filters .filter-control input {
			flex: 1;
			min-width: 0;
			border: none;
			background: transparent;
			color: var(--bs-body-color);
			padding: 0;
		}

		.event-filters .filter-control input:focus {
			outline: none;
			box-shadow: none;
		}

		.event-filters .button {
			background: #1387c1;
			color: #fff;
			border: none;
			border-radius: 0.6rem;
			padding: 0.6rem 1.5rem;
		}
	</style>
{% endblock %}
