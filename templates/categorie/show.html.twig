{% extends 'base.html.twig' %}

{% block title %}{% trans %}Catégorie{% endtrans %} | BxlEvent{% endblock %}

{% block body %}
    <h1>{% trans %}Categorie{% endtrans %}</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>{% trans %}Id{% endtrans %}</th>
                <td>{{ categorie.id }}</td>
            </tr>
            <tr>
                <th>{% trans %}Name{% endtrans %}</th>
                <td>{{ categorie.name }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_categorie_index') }}">{% trans %}back to list{% endtrans %}</a>

    <a href="{{ path('app_categorie_edit', {'id': categorie.id}) }}">{% trans %}edit{% endtrans %}</a>

    {{ include('categorie/_delete_form.html.twig') }}
{% endblock %}
