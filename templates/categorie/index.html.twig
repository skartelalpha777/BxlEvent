{% extends 'base.html.twig' %}

{% block title %}{% trans %}Catégories{% endtrans %} | BxlEvent{% endblock %}

{% block body %}
    <h1>{% trans %}Categorie index{% endtrans %}</h1>

    <table class="table">
        <thead>
            <tr>
                <th>{% trans %}Id{% endtrans %}</th>
                <th>{% trans %}Name{% endtrans %}</th>
                <th>{% trans %}actions{% endtrans %}</th>
            </tr>
        </thead>
        <tbody>
        {% for categorie in categories %}
            <tr>
                <td>{{ categorie.id }}</td>
                <td>{{ categorie.name }}</td>
                <td>
                    <a href="{{ path('app_categorie_show', {'id': categorie.id}) }}">{% trans %}show{% endtrans %}</a>
                    <a href="{{ path('app_categorie_edit', {'id': categorie.id}) }}">{% trans %}edit{% endtrans %}</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="3">{% trans %}no records found{% endtrans %}</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('app_categorie_new') }}">{% trans %}Create new{% endtrans %}</a>
{% endblock %}
