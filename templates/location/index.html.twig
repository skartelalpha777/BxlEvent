{% extends 'base.html.twig' %}

{% block title %}{% trans %}Lieux{% endtrans %} | BxlEvent{% endblock %}

{% block body %}
    <h1>{% trans %}Location index{% endtrans %}</h1>

    <table class="table">
        <thead>
            <tr>
                <th>{% trans %}Name{% endtrans %}</th>
                <th>{% trans %}Id{% endtrans %}</th>
                <th>{% trans %}Street{% endtrans %}</th>
                <th>{% trans %}Number{% endtrans %}</th>
                <th>{% trans %}Postcode{% endtrans %}</th>
                <th>{% trans %}City{% endtrans %}</th>
                <th>{% trans %}Details{% endtrans %}</th>
                <th>{% trans %}actions{% endtrans %}</th>
            </tr>
        </thead>
        <tbody>
        {% for location in locations %}
            <tr>
                <td>{{ location.name }}</td>
                <td>{{ location.id }}</td>
                <td>{{ location.street }}</td>
                <td>{{ location.number }}</td>
                <td>{{ location.postcode }}</td>
                <td>{{ location.city }}</td>
                <td>{{ location.details }}</td>
                <td>
                    <a href="{{ path('app_location_show', {'id': location.id}) }}">{% trans %}show{% endtrans %}</a>
                    <a href="{{ path('app_location_edit', {'id': location.id}) }}">{% trans %}edit{% endtrans %}</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="7">{% trans %}no records found{% endtrans %}</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('app_location_new') }}">{% trans %}Create new{% endtrans %}</a>
{% endblock %}
