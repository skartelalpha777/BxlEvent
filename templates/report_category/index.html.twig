{% extends 'base.html.twig' %}

{% block title %}{% trans %}Catégories de signalement{% endtrans %} | BxlEvent{% endblock %}

{% block body %}
    <h1>{% trans %}ReportCategory index{% endtrans %}</h1>

    <table class="table">
        <thead>
            <tr>
                <th>{% trans %}Id{% endtrans %}</th>
                <th>{% trans %}Label{% endtrans %}</th>
                <th>{% trans %}actions{% endtrans %}</th>
            </tr>
        </thead>
        <tbody>
        {% for report_category in report_categories %}
            <tr>
                <td>{{ report_category.id }}</td>
                <td>{{ report_category.label }}</td>
                <td>
                    <a href="{{ path('app_report_category_show', {'id': report_category.id}) }}">{% trans %}show{% endtrans %}</a>
                    <a href="{{ path('app_report_category_edit', {'id': report_category.id}) }}">{% trans %}edit{% endtrans %}</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="3">{% trans %}no records found{% endtrans %}</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('app_report_category_new') }}">{% trans %}Create new{% endtrans %}</a>
{% endblock %}
