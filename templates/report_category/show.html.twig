{% extends 'base.html.twig' %}

{% block title %}{% trans %}Catégorie de signalement{% endtrans %} | BxlEvent{% endblock %}

{% block body %}
    <h1>{% trans %}ReportCategory{% endtrans %}</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>{% trans %}Id{% endtrans %}</th>
                <td>{{ report_category.id }}</td>
            </tr>
            <tr>
                <th>{% trans %}Label{% endtrans %}</th>
                <td>{{ report_category.label }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_report_category_index') }}">{% trans %}back to list{% endtrans %}</a>

    <a href="{{ path('app_report_category_edit', {'id': report_category.id}) }}">{% trans %}edit{% endtrans %}</a>

    {{ include('report_category/_delete_form.html.twig') }}
{% endblock %}
