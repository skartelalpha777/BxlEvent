{% extends 'base.html.twig' %}

{% block title %}{% trans %}Paiement réussi{% endtrans %} | BxlEvent
{% endblock %}

{% block body %}
	<div class="container mt-5 mb-4 text-center">
		<h1 class="text-success">{% trans %}Merci pour votre achat !{% endtrans %}</h1>
		<p>{% trans %}Votre commande{% endtrans %}
			<strong>{{ order.reference }}</strong>
			{% trans %}a été validée avec succès.{% endtrans %}</p>

		<a href="{{ path('app_ticket_download', {'reference': order.reference}) }}" class="btn btn-primary btn-lg mt-4">
			<i class="bi bi-download"></i>
			{% trans %}Télécharger mes billets (PDF){% endtrans %}
		</a>
	</div>
{% endblock %}
