{% extends 'base.html.twig' %}

{% block title %}{% trans %}Billet{% endtrans %} | BxlEvent{% endblock %}

{% block body %}
    <h1>{% trans %}Ticket{% endtrans %}</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>{% trans %}Id{% endtrans %}</th>
                <td>{{ ticket.id }}</td>
            </tr>
            <tr>
                <th>{% trans %}Date{% endtrans %}</th>
                <td>{{ ticket.date ? ticket.date|date('Y-m-d') : '' }}</td>
            </tr>
            <tr>
                <th>{% trans %}code{% endtrans %}</th>
                <td>{{ ticket.code }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_ticket_index') }}">{% trans %}back to list{% endtrans %}</a>

    <a href="{{ path('app_ticket_edit', {'id': ticket.id}) }}">{% trans %}edit{% endtrans %}</a>

    {{ include('ticket/_delete_form.html.twig') }}
{% endblock %}
