{% extends 'base.html.twig' %}

{% block title %}{% trans %}Billets{% endtrans %} | BxlEvent{% endblock %}

{% block body %}
    <h1>{% trans %}Ticket index{% endtrans %}</h1>

    <table class="table">
        <thead>
            <tr>
                <th>{% trans %}Id{% endtrans %}</th>
                <th>{% trans %}Date{% endtrans %}</th>
                <th>{% trans %}eventID{% endtrans %}</th>
                <th>{% trans %}userID{% endtrans %}</th>
                <th>{% trans %}ticketTypeID{% endtrans %}</th>
                <th>{% trans %}code{% endtrans %}</th>
                <th>{% trans %}isScanned{% endtrans %}</th>
                <th>{% trans %}actions{% endtrans %}</th>
            </tr>
        </thead>
        <tbody>
        {% for ticket in tickets %}
            <tr>
                <td>{{ ticket.id }}</td>
                <td>{{ ticket.date ? ticket.date|date('Y-m-d') : '' }}</td>
                <td>{{ ticket.event.id }}</td>
                <td>{{ ticket.user.id }}</td>
                <td>{{ ticket.ticketType.id }}</td>
                <td>{{ ticket.code }}</td>
                <td>{{ ticket.isScanned }}</td>
                
                <td>
                    <a href="{{ path('app_ticket_show', {'id': ticket.id}) }}">{% trans %}show{% endtrans %}</a>
                    <a href="{{ path('app_ticket_edit', {'id': ticket.id}) }}">{% trans %}edit{% endtrans %}</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="4">{% trans %}no records found{% endtrans %}</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('app_ticket_new') }}">{% trans %}Create new{% endtrans %}</a>
{% endblock %}
