{% extends 'base.html.twig' %}

{% block title %}{% trans %}Galeries{% endtrans %} | BxlEvent{% endblock %}

{% block body %}
    <h1>{% trans %}Gallery index{% endtrans %}</h1>

    <table class="table">
        <thead>
            <tr>
                <th>{% trans %}Id{% endtrans %}</th>
                <th>{% trans %}Name{% endtrans %}</th>
                <th>{% trans %}IsMain{% endtrans %}</th>
                <th>{% trans %}actions{% endtrans %}</th>
            </tr>
        </thead>
        <tbody>
        {% for gallery in galleries %}
            <tr>
                <td>{{ gallery.id }}</td>
                <td>{{ gallery.name }}</td>
                <td>{{ (gallery.isMain ? 'Yes' : 'No')|trans }}</td>
                <td>
                    <a href="{{ path('app_gallery_show', {'id': gallery.id}) }}">{% trans %}show{% endtrans %}</a>
                    <a href="{{ path('app_gallery_edit', {'id': gallery.id}) }}">{% trans %}edit{% endtrans %}</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="4">{% trans %}no records found{% endtrans %}</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('app_gallery_new') }}">{% trans %}Create new{% endtrans %}</a>
{% endblock %}
