{% extends 'base.html.twig' %}

{% block title %}{% trans %}Signalement{% endtrans %} | BxlEvent{% endblock %}

{% block body %}
	<section class="pt-5 pb-5">
		<div class="container-fluid container-lg">
			<h1>{% trans %}Signalement{% endtrans %}</h1>
			<div class="dash-card p-4 mt-4">
				<div class="table-responsive rounded">
					<table class="table event-table border-0 align-middle">
						<thead>
							<tr>
								<th>{% trans %}Evènement concerné{% endtrans %}</th>
								<th>{% trans %}Utilisateur{% endtrans %}</th>
								<th>{% trans %}Description{% endtrans %}</th>
								<th>{% trans %}Date{% endtrans %}</th>
								<th>{% trans %}Categorie{% endtrans %}</th>
								<th>{% trans %}Traité{% endtrans %}</th>
							</tr>
						</thead>
						<tbody>
							<tr>
								<td>
									<a href="{{path('app_event_consult',{'id':report.event.id})}}">{{ report.event.title }}</a>
								</td>
								<td>{{ report.user.email }}</td>
								<td>{{ report.description }}</td>
								<td>{{ report.date ? report.date|date('Y-m-d') : '' }}</td>
								<td>{{ report.category.label }}</td>
								<td>
									<form method="POST" action="{{ path('app_reports_toggle_treated', {'id': report.id}) }}">
										<input type="hidden" name="_token" value="{{ csrf_token('toggle-treated' ~ report.id) }}">
										<input type="checkbox" onchange="this.form.submit()" {{ report.treated ? 'checked' : '' }}>
									</form>
								</td>
							</tr>
						</tbody>
					</table>
				</div>

				<div class="d-flex gap-3 mt-3">
					<a href="{{ path('app_reports_index') }}" class="button">{% trans %}Retour à la liste{% endtrans %}</a>
					{% if app.user.role.value == "admin" %}
						<a href="{{ path('app_reports_edit', {'id': report.id}) }}" class="button">{% trans %}Modifier{% endtrans %}</a>
					{% endif %}
					{{ include('reports/_delete_form.html.twig') }}
				</div>
			</div>
		</div>
	</section>
{% endblock %}
