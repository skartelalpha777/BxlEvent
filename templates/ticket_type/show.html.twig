{% extends 'base.html.twig' %}

{% block title %}{% trans %}Type de billet{% endtrans %} | BxlEvent{% endblock %}

{% block body %}
    <h1>{% trans %}TicketType{% endtrans %}</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>{% trans %}Id{% endtrans %}</th>
                <td>{{ ticket_type.id }}</td>
            </tr>
            <tr>
                <th>{% trans %}Label{% endtrans %}</th>
                <td>{{ ticket_type.label }}</td>
            </tr>
            <tr>
                <th>{% trans %}Price{% endtrans %}</th>
                <td>{{ ticket_type.price }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_ticket_type_index') }}">{% trans %}back to list{% endtrans %}</a>

    <a href="{{ path('app_ticket_type_edit', {'id': ticket_type.id}) }}">{% trans %}edit{% endtrans %}</a>

    {{ include('ticket_type/_delete_form.html.twig') }}
{% endblock %}
