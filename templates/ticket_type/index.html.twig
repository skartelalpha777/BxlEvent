{% extends 'base.html.twig' %}

{% block title %}{% trans %}Types de billets{% endtrans %} | BxlEvent{% endblock %}

{% block body %}
    <h1>{% trans %}TicketType index{% endtrans %}</h1>

    <table class="table">
        <thead>
            <tr>
                <th>{% trans %}Id{% endtrans %}</th>
                <th>{% trans %}Label{% endtrans %}</th>
                <th>{% trans %}Price{% endtrans %}</th>
                <th>{% trans %}actions{% endtrans %}</th>
            </tr>
        </thead>
        <tbody>
        {% for ticket_type in ticket_types %}
            <tr>
                <td>{{ ticket_type.id }}</td>
                <td>{{ ticket_type.label }}</td>
                <td>{{ ticket_type.price }}</td>
                <td>
                    <a href="{{ path('app_ticket_type_show', {'id': ticket_type.id}) }}">{% trans %}show{% endtrans %}</a>
                    <a href="{{ path('app_ticket_type_edit', {'id': ticket_type.id}) }}">{% trans %}edit{% endtrans %}</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="4">{% trans %}no records found{% endtrans %}</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('app_ticket_type_new') }}">{% trans %}Create new{% endtrans %}</a>
{% endblock %}
